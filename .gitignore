# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
# Local secret notes / scratch files (e.g. "Meter secrets.rtf")
*secret*.rtf
*secrets*
*.rtf

# --- Python ---
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- Node / web ---
web/node_modules/
web/dist/
# Generated public documentation (see docs/public-docs.md); rebuilt on demand.
web/dist-docs/
node_modules/
npm-debug.log*

# --- Local tooling settings (personal, not shared) ---
.claude/settings.local.json
# Claude Code session worktrees and local launch config: scratch, and large.
.claude/worktrees/
.claude/launch.json

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# SDK development virtualenv (created by `make test-sdk`).
sdk/python/.venv/
